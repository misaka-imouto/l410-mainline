[Unit]
Description=Huawei fingerprint daemon (vendor fingerprint_daemon)
Documentation=file:///usr/share/doc/l410/fingerprint.md
# The TA's SFS lives in /data/sec_storage_data/..., so the data partition
# (/dev/sdd7, _dde_data) must be mounted before the daemon starts.
After=teecd.service local-fs.target
Requires=teecd.service
RequiresMountsFor=/data

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/opt/uos-fp/lib
# Deassert the sensor reset (GPIO 281 on the L410) before the daemon runs.
ExecStartPre=-/usr/local/sbin/fp_poweron
ExecStart=/usr/bin/fingerprint_daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
