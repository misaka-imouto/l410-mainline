#!/bin/bash
# l410-charge-trace: 插拔一次电源适配器，把 EC 里跟充电有关的字段和 Type-C（TCA）状态
# 按时间记下来。给 BAT-02/BAT-03/BAT-10 用，也用来确认 EC 0x0280/0x81、0x82 里那两个
# 还没搞清含义的位（见 docs/hardware/laptop.md 的 EC 寄存器表）。
#
#   sudo l410-charge-trace [-i 秒] [-d 秒] [-o 文件]
#
#   -i  采样间隔，默认 1 秒
#   -d  录多久，默认 180 秒
#   -o  输出文件，默认 /var/tmp/l410-charge-trace-<时间>.log
#
# 录的时候做这两件事（AC 在线时先拔、离线时先插）：
#   第 10 秒左右拔掉适配器，第 40 秒左右插回去；想测充电速率就把电池放到 60-80% 再插。
# 每行一个采样；AC、电池状态、电流方向、EC 0x81/0x82 变化时打一行 "EVENT"。
# 结束时会重放这些 EVENT 并打印 EC 传输计数的增量，Ctrl-C 也能正常收尾。
# 只读：除了 EC 的信息寄存器，什么也不写。
set -u
[ "$(id -u)" = 0 ] || exec sudo -n "$0" "$@"

EC=/sys/kernel/debug/huawei-echub/read
STATS=/sys/kernel/debug/huawei-echub/stats
TCA=/sys/kernel/debug/kirin990-usb3/tca
BAT=/sys/class/power_supply/echub-battery
AC=/sys/class/power_supply/echub-ac

INTERVAL=1
DURATION=180
OUT=
while [ $# -gt 0 ]; do
	case $1 in
	-i) INTERVAL=$2; shift 2 ;;
	-d) DURATION=$2; shift 2 ;;
	-o) OUT=$2; shift 2 ;;
	-h|--help) sed -n '2,19p' "$0"; exit 0 ;;
	*) echo "unknown option $1 (see --help)" >&2; exit 2 ;;
	esac
done
OUT=${OUT:-/var/tmp/l410-charge-trace-$(date +%Y%m%d-%H%M%S).log}

[ -w "$EC" ] || { echo "!! $EC 不可写：没有 debugfs 或 huawei-echub 驱动" >&2; exit 1; }
[ -r "$AC/online" ] || { echo "!! 没有 $AC：dmesg | grep echub 看看" >&2; exit 1; }
[ -r "$TCA" ] || echo "!! 没有 $TCA（老内核？），tcpc/pstate/sts 三列会是 -" >&2

# ---- EC 访问 ---------------------------------------------------------------
# 一次传输 = 先写 "reg arg len"，再读回 "reg/arg: b0 b1 ..."；读失败打 "error"。
ec() {
	local line
	printf '%s %s %s' "$1" "$2" "$3" > "$EC" || return 1
	read -r line < "$EC" || return 1
	case $line in
	*"error"*) return 1 ;;
	esac
	printf '%s' "${line#*: }"
}
u16() { printf '%d' $((16#${1:-0} + (16#${2:-0} << 8))); }
s16() { local v=$1; [ "$v" -ge 32768 ] && v=$((v - 65536)); printf '%d' "$v"; }
tenths() { local c=$(($1 - 2731)); printf '%d.%d' $((c / 10)) $((c % 10)); }

# 四路温度逐字节读：0x0280 只支持 1 字节读（字读回 -EPROTO）
temp16() {
	local a b
	a=$(ec 0x0280 "$1" 1) && b=$(ec 0x0280 "$2" 1) && tenths "$(u16 "$a" "$b")" || echo -
}

# ---- EC 计数 ---------------------------------------------------------------
XF=0 ER=0 RT=0 SE=0 PE=0
stats_read() {
	XF=0 ER=0 RT=0 SE=0 PE=0
	[ -r "$STATS" ] || return 0
	local k v
	while IFS=': ' read -r k v; do
		[ -n "${v:-}" ] || continue
		case $k in
		xfers) XF=$v ;;
		errors) ER=$v ;;
		retries) RT=$v ;;
		status_errors) SE=$v ;;
		pec_errors) PE=$v ;;
		esac
	done < "$STATS"
}

# ---- 采样 ------------------------------------------------------------------
sample() {
	local s81 s82 b5a b5b b5c b5d icur ivolt ifull itemp
	ISO=$(date '+%Y-%m-%dT%H:%M:%S%:z')
	AC_ON=$(cat "$AC/online" 2> /dev/null || echo -)
	ST=$(cat "$BAT/status" 2> /dev/null || echo -)
	CAP=$(cat "$BAT/capacity" 2> /dev/null || echo -)

	s81=$(ec 0x0280 0x81 1) || s81=-
	s82=$(ec 0x0280 0x82 1) || s82=-
	b5a=$(ec 0x0280 0x5a 1) || b5a=-
	b5b=$(ec 0x0280 0x5b 1) || b5b=-
	b5c=$(ec 0x0280 0x5c 1) || b5c=-
	b5d=$(ec 0x0280 0x5d 1) || b5d=-

	icur=$(ec 0x0451 0x01 2) || icur=
	ivolt=$(ec 0x0451 0x06 2) || ivolt=
	ifull=$(ec 0x0451 0x08 2) || ifull=
	itemp=$(ec 0x0451 0x09 2) || itemp=

	CUR= VOLT= FULL= TEMP=-
	if [ -n "$icur" ]; then set -- $icur; CUR=$(s16 "$(u16 "$1" "$2")"); fi
	if [ -n "$ivolt" ]; then set -- $ivolt; VOLT=$(u16 "$1" "$2"); fi
	if [ -n "$ifull" ]; then set -- $ifull; FULL=$(u16 "$1" "$2"); fi
	if [ -n "$itemp" ]; then set -- $itemp; TEMP=$(tenths "$(u16 "$1" "$2")"); fi

	PWR=-
	if [ -n "$CUR" ] && [ -n "$VOLT" ]; then
		local p=$((CUR * VOLT))
		[ "$p" -lt 0 ] && p=$((-p))
		PWR=$(printf '%d.%d' $((p / 1000000)) $((p % 1000000 / 100000)))
	fi

	T1=$(temp16 0x50 0x51)
	T2=$(temp16 0x52 0x53)
	T3=$(temp16 0x54 0x55)
	T4=$(temp16 0x56 0x57)

	TCPC=- PSTATE=- STS=-
	if [ -r "$TCA" ]; then
		TCPC=$(awk '/^tca_tcpc/ { print $2 }' "$TCA")
		PSTATE=$(awk '/^tca_pstate/ { print $2 }' "$TCA")
		STS=$(awk '/^tca_sts/ { print $2 }' "$TCA")
	fi

	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$ISO" "${AC_ON:--}" "${ST:--}" "${CAP:--}" "${CUR:--}" "${VOLT:--}" "${FULL:--}" \
		"${PWR:--}" "${TEMP:--}" "${s81:--}" "${s82:--}" \
		"$T1" "$T2" "$T3" "$T4" "${b5a:--}" "${b5b:--}" "${b5c:--}" "${b5d:--}" \
		"$TCPC" "$PSTATE" "$STS" >> "$OUT"

	DIR=idle
	if [ -n "$CUR" ]; then
		[ "$CUR" -gt 50 ] && DIR=chg
		[ "$CUR" -lt -50 ] && DIR=dis
	fi
	local key="$AC_ON|$ST|$DIR|$s81|$s82"
	if [ -z "${PREV_KEY:-}" ] || [ "$key" != "$PREV_KEY" ]; then
		local msg
		msg=$(printf 'EVENT %s  AC=%s %s %s%%  battery %s mA / %s mV (%s W)  0x81=%s 0x82=%s  5a-5d=%s %s %s %s  tcpc=%s pstate=%s sts=%s' \
			"$ISO" "${AC_ON:--}" "${ST:--}" "${CAP:--}" "${CUR:--}" "${VOLT:--}" "${PWR:--}" \
			"${s81:--}" "${s82:--}" "${b5a:--}" "${b5b:--}" "${b5c:--}" "${b5d:--}" \
			"$TCPC" "$PSTATE" "$STS")
		if [ -z "${PREV_KEY:-}" ]; then
			printf '%s\n' "${msg/EVENT/START}" >> "$EVENTS"
		else
			printf '%s\n' "$msg" >> "$OUT"
			printf '%s\n' "# $msg" >> "$EVENTS"
			printf '%s\n' "$msg" >&2
		fi
	fi
	PREV_KEY=$key
}

progress() {
	[ -t 2 ] || return 0
	printf '\r  %3d/%3ds  AC=%s %-11s %3s%%  %5s mA %5s mV %5s W  t=%s  0x81=%s 0x82=%s    ' \
		"$1" "$DURATION" "${AC_ON:--}" "${ST:--}" "${CAP:--}" "${CUR:--}" "${VOLT:--}" \
		"${PWR:--}" "${TEMP:--}" "${s81:--}" "${s82:--}" >&2
}

finish() {
	trap - INT TERM
	echo >&2
	{
		echo
		echo "# --- events ---"
		if [ -s "$EVENTS" ]; then cat "$EVENTS"; else
			echo "# (没有变化：AC/电池状态/电流方向/EC 0x81-0x82 全程没变)"
		fi
		echo
		echo "# --- summary ---"
		echo "# $OUT: $(grep -c '^20[0-9][0-9]-' "$OUT") samples"
		echo "# EC before: xfers=$XF0 errors=$ER0 retries=$RT0 status_errors=$SE0 pec_errors=$PE0"
		stats_read
		echo "# EC after:  xfers=$XF errors=$ER retries=$RT status_errors=$SE pec_errors=$PE"
		printf '# EC delta: xfers +%d, errors +%d, retries +%d, status_errors +%d, pec_errors +%d\n' \
			$((XF - XF0)) $((ER - ER0)) $((RT - RT0)) $((SE - SE0)) $((PE - PE0))
	} | tee -a "$OUT" >&2
	exit 0
}

EVENTS=$(mktemp) || exit 1
trap finish INT TERM

stats_read
XF0=$XF ER0=$ER RT0=$RT SE0=$SE PE0=$PE

{
	echo "# l410-charge-trace $(date -Is)  interval ${INTERVAL}s  duration ${DURATION}s"
	echo "# kernel $(uname -r)"
	echo "# EC before: xfers=$XF errors=$ER retries=$RT status_errors=$SE pec_errors=$PE"
	echo "# columns: iso ac status capacity% current_mA voltage_mV full_mAh battery_W temp_C"
	echo "#          0x81 0x82 t1 t2 t3 t4 (C) 0x5a 0x5b 0x5c 0x5d tcpc pstate tca_sts"
} >> "$OUT"

AC0=$(cat "$AC/online" 2> /dev/null || echo ?)
if [ "$AC0" = 1 ]; then
	HINT='AC 现在在线：第 10 秒左右拔掉适配器，第 40 秒左右插回去'
else
	HINT='AC 现在离线：第 10 秒左右插上适配器，第 40 秒左右拔掉'
fi
echo "== 录 ${DURATION}s 到 $OUT" >&2
echo "== $HINT" >&2

start=$(date +%s)
while :; do
	sample
	elapsed=$(($(date +%s) - start))
	progress "$elapsed"
	[ "$elapsed" -ge "$DURATION" ] && break
	sleep "$INTERVAL"
done
finish
